# Copy to .env.local and fill in. Leave any of these empty and Waymark still runs:
#   - no Supabase values → sign-in is turned off and the sample-data demo is used
#   - no Mapbox token    → manual place entry and a simplified map

# Supabase project → Settings → API. Use the public "anon" or "publishable" key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer projects can use this instead of the anon key:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mapbox → Account → Tokens. A public token (pk.…) restricted to your domains.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Never put the Supabase service-role key in this app. It isn't needed.
